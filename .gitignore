# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime data (voice profiles, generated WAVs, logs)
mcp_voice_studio/data/voices/*
!mcp_voice_studio/data/voices/.gitkeep
mcp_voice_studio/data/outputs/*
!mcp_voice_studio/data/outputs/.gitkeep
mcp_voice_studio/data/logs/*
!mcp_voice_studio/data/logs/.gitkeep
mcp_voice_studio/data/inputs/*
!mcp_voice_studio/data/inputs/.gitkeep

# Runtime data (root-level, where outputs actually land)
data/outputs/*
!data/outputs/.gitkeep
data/voices/*
!data/voices/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/inputs/*
!data/inputs/.gitkeep

# Generated audio anywhere
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Secrets
.env
*.pem

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
